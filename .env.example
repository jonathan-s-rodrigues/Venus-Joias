# Configure estas variáveis em Vercel → Settings → Environment Variables (nunca commite o .env real)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx           # Mercado Pago → Suas integrações → Credenciais
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # JSON da conta de serviço (em uma linha)
SITE_URL=https://seu-site.vercel.app       # opcional; sem barra no final
# Devem ser iguais aos de js/config.js:
DESCONTO_PIX=0.05
FRETE_ENVIO=20
FRETE_GRATIS_ACIMA=250
PARCELAS_MAX=3

# Frete real (Melhor Envio) — sem MELHORENVIO_TOKEN o site usa o frete fixo FRETE_ENVIO
MELHORENVIO_TOKEN=                          # token da API (comece pelo de sandbox)
MELHORENVIO_ENV=sandbox                     # 'sandbox' para testes; apague ou use 'producao' para valer
CEP_ORIGEM=00000000                         # CEP de onde você despacha (só números)
CONTATO_EMAIL=seu@email.com                 # exigido pelo Melhor Envio no User-Agent
PACOTE_PESO_KG=0.1
PACOTE_LARGURA=11
PACOTE_ALTURA=2
PACOTE_COMPRIMENTO=16

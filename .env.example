# Configure estas variáveis em Vercel → Settings → Environment Variables (nunca commite o .env real)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx           # Mercado Pago → Suas integrações → Credenciais
FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}   # JSON da conta de serviço (em uma linha)
SITE_URL=https://seu-site.vercel.app       # opcional; sem barra no final
# Devem ser iguais aos de js/config.js:
DESCONTO_PIX=0.05
FRETE_ENTREGA=15
FRETE_GRATIS_ACIMA=250
PARCELAS_MAX=3
